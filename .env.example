# CoinGecko Demo (free) plan key. Sent as the x-cg-demo-api-key header.
COINGECKO_API_KEY=

# Canonical origin. Defaults to http://localhost:3000 when unset.
# A production deploy must set it: the build refuses to proceed without it when
# VERCEL_ENV is production, so the localhost fallback never reaches a canonical.
NEXT_PUBLIC_SITE_URL=

# API budget. Blank means the development defaults: 10 tokens, 10 prerendered
# token pages, 600 s. See the README for the arithmetic behind each one.
ATLAS_TOKEN_COUNT=
ATLAS_PRERENDERED_TOKEN_COUNT=
ATLAS_LISTING_REVALIDATE_SECONDS=
