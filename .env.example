# CoinGecko Demo (free) plan key. Not required yet: see TODO in
# src/shared/config/env.ts. Sent as the x-cg-demo-api-key header.
COINGECKO_API_KEY=

# Canonical origin. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# API budget. Blank means the development defaults: 10 tokens, 600 s.
# Production sets only the count, to 250: the interval is 600 everywhere.
ATLAS_TOKEN_COUNT=
ATLAS_LISTING_REVALIDATE_SECONDS=
